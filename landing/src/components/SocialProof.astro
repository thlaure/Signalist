---
import type { Translations } from '../i18n/translations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const { socialProof } = t;

const avatarColors = [
  'bg-indigo-100 text-indigo-700',
  'bg-violet-100 text-violet-700',
  'bg-sky-100 text-sky-700',
];
---

<section class="py-24 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-3">{socialProof.label}</p>
      <h2 class="text-4xl font-black text-slate-900 tracking-tight">
        {socialProof.headline}
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {socialProof.testimonials.map((testimonial, i) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-8 flex flex-col">
          <div class="flex gap-1 mb-5">
            {[...Array(5)].map(() => (
              <svg class="w-4 h-4 text-amber-400 fill-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <blockquote class="text-slate-600 leading-relaxed flex-1 mb-6">
            "{testimonial.quote}"
          </blockquote>
          <div class="flex items-center gap-3">
            <div class={`w-10 h-10 rounded-full ${avatarColors[i]} flex items-center justify-center font-bold text-sm shrink-0`}>
              {testimonial.initials}
            </div>
            <div>
              <p class="font-semibold text-slate-900 text-sm">{testimonial.author}</p>
              <p class="text-slate-400 text-xs">{testimonial.role} · {testimonial.company}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
