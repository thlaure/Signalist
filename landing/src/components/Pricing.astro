---
import type { Translations } from '../i18n/translations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const { pricing } = t;
---

<section id="pricing" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-3">{pricing.label}</p>
      <h2 class="text-4xl font-black text-slate-900 tracking-tight">{pricing.headline}</h2>
      <p class="mt-4 text-lg text-slate-500">{pricing.subheadline}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 items-start">
      {pricing.plans.map((plan, i) => (
        <div class={`rounded-2xl border p-8 relative ${plan.featured ? 'border-indigo-500 bg-indigo-600 text-white shadow-xl shadow-indigo-200' : 'border-slate-200 bg-white'}`}>
          {plan.featured && (
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-white text-indigo-600 text-xs font-bold px-3 py-1 rounded-full border border-indigo-200 whitespace-nowrap">
              {pricing.popularBadge}
            </span>
          )}

          <div class="mb-6">
            <h3 class={`font-bold text-lg mb-1 ${plan.featured ? 'text-white' : 'text-slate-900'}`}>{plan.name}</h3>
            <div class="flex items-baseline gap-1">
              <span class={`text-4xl font-black ${plan.featured ? 'text-white' : 'text-slate-900'}`}>{plan.price}</span>
              <span class={`text-sm ${plan.featured ? 'text-indigo-200' : 'text-slate-400'}`}>/ {plan.period}</span>
            </div>
            <p class={`mt-3 text-sm leading-relaxed ${plan.featured ? 'text-indigo-100' : 'text-slate-500'}`}>{plan.description}</p>
          </div>

          <ul class="space-y-3 mb-8">
            {plan.limits.map((limit, j) => (
              <li class={`flex items-center gap-2.5 text-sm ${plan.featured ? 'text-indigo-100' : 'text-slate-600'} ${limit === '—' ? 'opacity-35' : ''}`}>
                {limit === '—' ? (
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 16 16"><path d="M4 8h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                ) : (
                  <svg class={`w-4 h-4 shrink-0 ${plan.featured ? 'text-indigo-200' : 'text-indigo-500'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                )}
                <span><span class="font-medium">{pricing.featureLabels[j]}:</span> {limit}</span>
              </li>
            ))}
          </ul>

          <a
            href={plan.ctaHref}
            class={`block text-center font-semibold py-3 rounded-xl transition-colors text-sm ${
              plan.featured
                ? 'bg-white text-indigo-600 hover:bg-indigo-50'
                : 'bg-indigo-600 hover:bg-indigo-700 text-white'
            }`}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
