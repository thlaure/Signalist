---
import type { Translations } from '../i18n/translations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const { waitlist } = t;
const privacyPath = Astro.url.pathname.startsWith('/fr') ? '/fr/privacy' : '/privacy';
const endpoint = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8000/api/v1';
---
<section id="waitlist" class="py-24 bg-white">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
    <div class="bg-gradient-to-br from-indigo-600 to-violet-600 rounded-3xl p-12 text-white">
      <h2 class="text-4xl font-black tracking-tight mb-4">
        {waitlist.headline}
      </h2>
      <p class="text-indigo-100 text-lg mb-10 leading-relaxed">
        {waitlist.subheadline}
      </p>

      <form id="waitlist-form" data-endpoint={endpoint} class="flex flex-col gap-3 max-w-md mx-auto" data-success={waitlist.success} data-error={waitlist.error}>
        <div class="flex flex-col sm:flex-row gap-3">
        <input
          type="email"
          name="email"
          placeholder={waitlist.placeholder}
          aria-label={waitlist.placeholder}
          required
          autocomplete="email"
          class="flex-1 px-4 py-3.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-indigo-200 focus:outline-none focus:ring-2 focus:ring-white/40 transition text-sm"
        />
        <button
          type="submit"
          class="bg-white text-indigo-600 font-bold px-6 py-3.5 rounded-xl hover:bg-indigo-50 transition-colors text-sm whitespace-nowrap"
        >
          {waitlist.button}
        </button>
        </div>

      <label class="inline-flex items-start gap-2.5 mt-5 text-left max-w-md mx-auto cursor-pointer">
        <input
          type="checkbox"
          name="consent"
          required
          class="mt-0.5 w-4 h-4 rounded border-white/30 bg-white/10 text-indigo-600 shrink-0"
        />
        <span class="text-indigo-100 text-xs leading-relaxed">
          {waitlist.consent} <a href={privacyPath} class="underline underline-offset-2 hover:text-white">{waitlist.privacyLink}</a>.
        </span>
      </label>
        <p role="status" aria-live="polite" class="text-sm" data-result></p>
      </form>
    </div>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('#waitlist-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const result = form.querySelector<HTMLElement>('[data-result]');
    if (!button || !result) return;
    button.disabled = true;
    result.textContent = '';
    const data = new FormData(form);
    try {
      const response = await fetch(`${form.dataset.endpoint}/waitlist`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.get('email'), consent: data.get('consent') === 'on' }),
      });
      if (!response.ok) throw new Error('Request failed');
      result.textContent = form.dataset.success ?? '';
      form.reset();
    } catch { result.textContent = form.dataset.error ?? ''; }
    finally { button.disabled = false; }
  });
</script>
