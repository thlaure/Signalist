---
const features = [
  {
    step: '01',
    title: 'Monitor',
    headline: 'One inbox for every source that matters',
    description:
      'Aggregate hundreds of RSS feeds across categories. Filter by keyword, topic, or relevance score. Get a clean, unified inbox instead of a dozen browser tabs.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" /></svg>`,
    color: 'indigo',
  },
  {
    step: '02',
    title: 'Curate',
    headline: 'AI reads it so your team doesn\'t have to',
    description:
      'Automatic summaries, AI-generated tags, and relevance scoring cut reading time by 80%. Bookmark what matters with a single click and annotate for context.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>`,
    color: 'violet',
  },
  {
    step: '03',
    title: 'Synthesize',
    headline: 'Weekly briefings that write themselves',
    description:
      'Generate AI-powered newsletters from your curated bookmarks. Configure reading time (5 min, 10 min), schedule delivery, and let Signalist handle the rest.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>`,
    color: 'blue',
  },
  {
    step: '04',
    title: 'Publish',
    headline: 'Share insights across every channel',
    description:
      'Post AI-generated recaps to LinkedIn, X, and more in one click. Schedule your weekly social recap and maintain a consistent presence without the manual effort.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" /></svg>`,
    color: 'sky',
  },
];

const colorMap: Record<string, { bg: string; text: string; badge: string }> = {
  indigo: { bg: 'bg-indigo-50', text: 'text-indigo-600', badge: 'bg-indigo-100 text-indigo-700' },
  violet: { bg: 'bg-violet-50', text: 'text-violet-600', badge: 'bg-violet-100 text-violet-700' },
  blue: { bg: 'bg-blue-50', text: 'text-blue-600', badge: 'bg-blue-100 text-blue-700' },
  sky: { bg: 'bg-sky-50', text: 'text-sky-600', badge: 'bg-sky-100 text-sky-700' },
};
---

<section id="features" class="py-24 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-3">How it works</p>
      <h2 class="text-4xl font-black text-slate-900 tracking-tight">
        From raw feeds to polished insights
      </h2>
      <p class="mt-4 text-lg text-slate-500 max-w-2xl mx-auto">
        A four-step loop your comms team runs on autopilot.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {features.map((f) => {
        const c = colorMap[f.color];
        return (
          <div class="bg-white rounded-2xl border border-slate-200 p-8 hover:shadow-md hover:border-slate-300 transition-all">
            <div class="flex items-start gap-4 mb-4">
              <div class={`w-11 h-11 rounded-xl ${c.bg} ${c.text} flex items-center justify-center shrink-0`}
                set:html={f.icon}
              />
              <div>
                <span class={`text-xs font-bold uppercase tracking-widest ${c.text}`}>{f.step} — {f.title}</span>
                <h3 class="text-lg font-bold text-slate-900 mt-1">{f.headline}</h3>
              </div>
            </div>
            <p class="text-slate-500 leading-relaxed">{f.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
