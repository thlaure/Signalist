{
    "name": "signalist/app",
    "type": "project",
    "license": "proprietary",
    "description": "AI-powered RSS intelligence platform",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*",
        "api-platform/doctrine-orm": "^4.4.10",
        "api-platform/symfony": "^4.4.10",
        "doctrine/dbal": "^4.6",
        "doctrine/doctrine-bundle": "^3.4.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.8",
        "laminas/laminas-feed": "^2.27",
        "lexik/jwt-authentication-bundle": "^3.2",
        "mcp/sdk": "^0.10",
        "nelmio/cors-bundle": "^2.6",
        "nyholm/psr7": "^1.8.3",
        "stripe/stripe-php": "^22.1",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/psr-http-message-bridge": "^8.1.12",
        "symfony/rate-limiter": "8.1.*",
        "symfony/redis-messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "behat/behat": "^4.1.1",
        "behat/mink": "^1.13",
        "behat/mink-browserkit-driver": "^2.3",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friends-of-behat/mink-extension": "^3.0@alpha",
        "friends-of-behat/symfony-extension": "^2.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpro/grumphp": ">=2.27.2",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-doctrine": "^2.1.2",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^11.5.58",
        "rector/rector": "^2.9.2",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/phpunit-bridge": "^8.1.12",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpro/grumphp": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "audit": {
            "ignore-abandoned": ["doctrine/common"]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
