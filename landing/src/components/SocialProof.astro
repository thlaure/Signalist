---
import type { Translations } from '../i18n/translations';
interface Props { t: Translations; }
const { t } = Astro.props;
const { socialProof } = t;
---
<section class="py-24 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-3">{socialProof.label}</p>
      <h2 class="text-4xl font-black text-slate-900 tracking-tight">{socialProof.headline}</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {socialProof.items.map((item) => <div class="bg-white rounded-2xl border border-slate-200 p-8">
        <h3 class="font-bold text-slate-900 text-lg mb-3">{item.title}</h3>
        <p class="text-slate-600 leading-relaxed">{item.description}</p>
      </div>)}
    </div>
  </div>
</section>
