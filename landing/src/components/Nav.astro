---
import type { Translations } from '../i18n/translations';

interface Props {
  t: Translations;
  lang: 'en' | 'fr';
}

const { t, lang } = Astro.props;
const altHref = lang === 'en' ? '/fr/' : '/';
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-slate-100">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 font-bold text-lg text-slate-900">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="8" fill="#4f46e5"/>
        <path d="M8 10h16M8 16h10M8 22h13" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="24" cy="22" r="4" fill="#a5b4fc"/>
      </svg>
      Signalist
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
      <a href="#features" class="hover:text-slate-900 transition-colors">{t.nav.features}</a>
      <a href="#pricing" class="hover:text-slate-900 transition-colors">{t.nav.pricing}</a>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={altHref}
        class="text-xs font-semibold text-slate-400 hover:text-slate-700 transition-colors uppercase tracking-wide"
      >
        {lang === 'en' ? 'FR' : 'EN'}
      </a>
      <a
        href="#waitlist"
        class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
      >
        {t.nav.cta}
      </a>
    </div>
  </nav>
</header>
